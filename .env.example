VITE_SYNCFUSION_LICENSE_KEY=

# URL del Word Processor Server de Syncfusion (contenedor Docker en
# backend/docker-compose.yml). Requerido para funciones server-side del
# editor, como el pegado con formato enriquecido.
VITE_SYNCFUSION_SERVICE_URL=http://localhost:7002/api/documenteditor/

# URL del backend propio de Muninn (guardado/carga de documentos).
VITE_BACKEND_URL=http://localhost:7001
